// MedConnect Telemedicine Platform: paste this into https://dbdiagram.io

Table users {
  user_id bigint [pk, increment]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(10) [not null, note: 'patient | doctor | admin']
  created_at timestamp [not null, default: `now()`]
}

Table specialty {
  specialty_id int [pk, increment]
  name varchar(100) [not null, unique]
}

Table patient {
  patient_id bigint [pk, increment]
  user_id bigint [not null, unique]
  full_name varchar(150) [not null]
  date_of_birth date [not null]
  gender varchar(10)
  phone varchar(20)
  blood_group varchar(3)
  allergies text
}

Table doctor {
  doctor_id bigint [pk, increment]
  user_id bigint [not null, unique]
  specialty_id int [not null]
  full_name varchar(150) [not null]
  license_no varchar(50) [not null, unique]
  consultation_fee numeric(10,2) [not null]
}

Table availability_slot {
  slot_id bigint [pk, increment]
  doctor_id bigint [not null]
  start_time timestamp [not null]
  end_time timestamp [not null]
  is_booked boolean [not null, default: false]

  indexes {
    (doctor_id, start_time) [unique]
    (slot_id, doctor_id) [unique]
  }
}

Table consultation {
  consultation_id bigint [pk, increment]
  patient_id bigint [not null]
  doctor_id bigint [not null]
  slot_id bigint [not null, unique]
  mode varchar(10) [not null, note: 'video | audio | chat']
  status varchar(15) [not null, note: 'Scheduled | In-Progress | Completed | Cancelled']
  reason text
  started_at timestamp
  ended_at timestamp
}

Table diagnosis {
  diagnosis_id bigint [pk, increment]
  consultation_id bigint [not null]
  description varchar(255) [not null]
  notes text
}

Table drug {
  drug_id int [pk, increment]
  name varchar(150) [not null, unique]
  form varchar(30)
  unit varchar(20)
}

Table prescription {
  prescription_id bigint [pk, increment]
  consultation_id bigint [not null]
  issued_at timestamp [not null, default: `now()`]
}

Table prescription_item {
  prescription_id bigint [not null]
  drug_id int [not null]
  dosage varchar(100) [not null]
  duration_days int [not null]

  indexes {
    (prescription_id, drug_id) [pk]
  }
}

Table payment {
  payment_id bigint [pk, increment]
  consultation_id bigint [not null, unique]
  amount numeric(10,2) [not null]
  method varchar(20) [not null]
  status varchar(10) [not null, note: 'Pending | Paid | Failed | Refunded']
  paid_at timestamp
}

Table review {
  review_id bigint [pk, increment]
  consultation_id bigint [not null, unique]
  rating int [not null, note: '1 to 5']
  comment text
  created_at timestamp [not null, default: `now()`]
}

// Relationships
Ref: patient.user_id - users.user_id
Ref: doctor.user_id - users.user_id
Ref: doctor.specialty_id > specialty.specialty_id
Ref: availability_slot.doctor_id > doctor.doctor_id
Ref: consultation.patient_id > patient.patient_id
Ref: consultation.slot_id - availability_slot.slot_id
Ref: consultation.doctor_id > doctor.doctor_id
Ref: diagnosis.consultation_id > consultation.consultation_id
Ref: prescription.consultation_id > consultation.consultation_id
Ref: prescription_item.prescription_id > prescription.prescription_id
Ref: prescription_item.drug_id > drug.drug_id
Ref: payment.consultation_id - consultation.consultation_id
Ref: review.consultation_id - consultation.consultation_id
